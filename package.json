{
  "name": "client-web",
  "private": true,
  "version": "0.1.0",
  "description": "End-user web app of the multi-currency wallet",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "dev:mocks": "vite --mode mocks",
    "build": "npm run lint && tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "schema:pull": "node scripts/schema-pull.ts",
    "codegen": "graphql-codegen --config codegen.ts",
    "infra": "sh -c 'if [ ! -x ../ops/dev.sh ]; then echo \"infra: ../ops/dev.sh not found. Clone the ops repository next to this one: git clone git@github.com:Internship-2026-Multi-currency-Wallet/ops.git ../ops\" >&2; exit 1; fi; exec ../ops/dev.sh \"$@\"' infra",
    "infra:up": "npm run infra -- up",
    "infra:down": "npm run infra -- down",
    "infra:ps": "npm run infra -- ps"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^7.0.5",
    "@mui/material": "^9.5.0",
    "@reduxjs/toolkit": "^2.13.0",
    "graphql": "^16.14.2",
    "graphql-request": "^7.4.0",
    "graphql-ws": "^6.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-redux": "^9.3.1",
    "react-router": "^8.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/client-preset": "^6.2.3",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@parcel/watcher": "^2.6.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "msw": "^3.0.3",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
