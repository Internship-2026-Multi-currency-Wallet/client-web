# Copy to .env.local to change the defaults of `npm run dev`. All values are optional.
# Vite inlines VITE_* values at build time.

# Environment profile: local | staging | kvitka-uat | wisla-uat (see src/config-env.ts)
VITE_APP_ENV=local

# Client this build is for: demo | kvitka | wisla
VITE_CLIENT=demo

# Backend GraphQL endpoints (override the profile values)
VITE_WALLET_CORE_URL=http://localhost:3000/graphql
VITE_RATES_SERVICE_URL=http://localhost:3001/graphql
VITE_RATES_SERVICE_WS_URL=ws://localhost:3001/graphql

# true = Mock Service Worker answers all GraphQL calls (no backends needed)
VITE_USE_MOCKS=false

# Dev auth user "<userId>:<perm1,perm2>" → header "Authorization: Dev 1:wallet".
# Works only against backends started with DEV_AUTH=true. Leave empty to be anonymous.
VITE_DEV_USER=1:wallet
